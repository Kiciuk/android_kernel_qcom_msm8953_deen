board_id_pin {	
	board_id_active: active {
	
		mux {
			pins = "gpio62", "gpio63", "gpio66";
			function = "gpio";
		};

		config {
			pins = "gpio62", "gpio63", "gpio66";
			drive-strength = <2>;
                        input-enable;
                        bias-pull-up;
		};
	};

	board_id_suspend: suspend {
	
		mux {
			pins = "gpio62", "gpio63", "gpio66";
			function = "gpio";
		};

		config {
			pins = "gpio62", "gpio63", "gpio66";
			drive-strength = <2>;
                        input-enable;
                        bias-pull-down;
		};
	};
};

 goodix_reset {	
	goodix_reset_active: active {
	
		mux {
			pins = "gpio110";
			function = "gpio";
		};

		config {
			pins = "gpio110";
			drive-strength = <2>;
                        bias-disable;
                        output-high;
		};
	};

	goodix_reset_suspend: suspend {
	
		mux {
			pins = "gpio110";
			function = "gpio";
		};

		config {
			pins = "gpio110";
			drive-strength = <2>;
                        bias-disable;
                        output-low;
		};
	};
};
     
     
     
     
