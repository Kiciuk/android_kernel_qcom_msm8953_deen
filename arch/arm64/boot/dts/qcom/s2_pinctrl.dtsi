&msm_gpio {

disabled-pins = <0 1 2 3 8 9 10 11>;


/*
/delete-node/  cam_sensor_front_vdig;
/delete-node/   cam_sensor_front_vdig_sleep;
/delete-node/ cdc_reset_ctrl;
*/

/delete-node/ pmx_sdc3_clk;
/delete-node/ pmx_sdc3_cmd;
/delete-node/ pmx_sdc3_dat;
 /delete-node/ sdc3_wlan_gpio;
 /delete-node/  cam_sensor_rear_vana;
/delete-node/  cam_sensor_rear_vana_sleep;

/delete-node/   cam_sensor_mclk2_default;
/delete-node/  cam_sensor_mclk2_sleep;
/delete-node/  cam_sensor_front1_default;
/delete-node/  cam_sensor_front1_sleep;
/delete-node/  pmx_rd_nfc_int;
 /delete-node/ pmx_nfc_reset;
 
audio_switch_pin {	
	audio_switch_active: active {
	
		mux {
			pins = "gpio111";
			function = "gpio";
		};

		config {
			pins = "gpio111";
			drive-strength = <6>;
                        bias-pull-up;
		};
	};
	
	audio_switch_suspend: suspend {
		
		mux {
			pins = "gpio111";
			function = "gpio";
		};

		config {
			pins = "gpio111";
			drive-strength = <2>;
                        bias-pull-down;
		};
	};
};

