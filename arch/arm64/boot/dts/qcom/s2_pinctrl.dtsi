&ts_int_active {
config {
 /delete-property/  bias-pull-up;
bias-disable;
input-enable;
};
};
&ts_int_suspend {
config {
output-low;
 /delete-property/  bias-pull-down;
};
};

&ts_reset_suspend {
config {
 /delete-property/  bias-pull-down;
output-low;
};
};



&mdss_dsi_active {
mux {
	pins = "gpio25";
};

config {
	pins = "gpio25";
	};
};
&mdss_dsi_suspend {
mux {
	pins = "gpio25";
};

config {
	pins = "gpio25";
	};
};

