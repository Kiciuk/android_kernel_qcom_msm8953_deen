	pins = "gpio113";
};

config {
	pins = "gpio113";
	};
};

&gpio_key_suspend {
mux {
	pins = "gpio113";
};

config {
	pins = "gpio113";
	};
};

&cross_conn_det_act {
mux {
	pins = "gpio69";
};

config {
	pins = "gpio69";
	/delete-property/ output-low;
	};
};

&cross_conn_det_sus {
mux {
	pins = "gpio69";
};

config {
	pins = "gpio69";
	};
};
  
&cam_sensor_rear_default {
	mux {
		pins = "gpio35", "gpio36", "gpio143", "gpio144";
	};

	config {
		pins = "gpio35", "gpio36", "gpio143", "gpio144";
	};
};

&cam_sensor_rear_sleep {
	mux {
		pins = "gpio35", "gpio36", "gpio143", "gpio144";
	};

	config {
		pins = "gpio35", "gpio36", "gpio143", "gpio144";
	};
};

